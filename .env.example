# --- Database ---
# Local: install PostgreSQL or run `docker run -p 5432:5432 -e POSTGRES_PASSWORD=postgres postgres:16`
# Cloud (no install needed): Neon, Supabase, Railway, etc.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/fuel_rewards?schema=public"

# --- App / sessions ---
# Public base URL this server is reachable at (Apple's servers call back into this for PassKit Web Service + APNs needs HTTPS in prod)
APP_BASE_URL="http://localhost:3000"
SESSION_SECRET="replace-with-a-long-random-string"

# --- Loyalty program ---
STAMP_WINDOW_DAYS=15

# --- Apple Wallet (PassKit) ---
APPLE_TEAM_ID="2NP49AWVYH"
APPLE_PASS_TYPE_IDENTIFIER="pass.com.ufcgym.fuel"
APPLE_PASS_CERT_PATH="./secrets/apple/passTypeCert.pem"
APPLE_PASS_KEY_PATH="./secrets/apple/passTypeKey.pem"
APPLE_PASS_KEY_PASSPHRASE=""
APPLE_WWDR_CERT_PATH="./secrets/apple/wwdr.pem"
# Organization name shown on the pass
APPLE_ORGANIZATION_NAME="UFC GYM"

# --- Google Wallet ---
GOOGLE_WALLET_ISSUER_ID=""
GOOGLE_WALLET_SERVICE_ACCOUNT_PATH="./secrets/google/service-account.json"
GOOGLE_WALLET_CLASS_ID="fuel_rewards_class"

# --- Seed / initial admin account ---
SEED_ADMIN_EMAIL="admin@ufcgym.mx"
SEED_ADMIN_PASSWORD="change-me-now"
